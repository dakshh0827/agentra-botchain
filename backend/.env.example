# App
PORT=
NODE_ENV=

# Database (MongoDB via Prisma)
DATABASE_URL=

# Redis
REDIS_URL=

# Auth
JWT_SECRET=

# Blockchain
BLOCKCHAIN_RPC_URL=
AGENTRA_CONTRACT_ADDRESS=
PRIVATE_KEY=

# 0G Storage
OG_STORAGE_RPC_URL=
OG_STORAGE_INDEXER_RPC=
OG_STORAGE_PRIVATE_KEY=

# Platform
PLATFORM_FEE_PERCENT=
MAX_CALL_DEPTH=
CALL_TIMEOUT_MS=

# License signing (EdDSA/Ed25519 PKCS8 PEM) — public key counterpart lives in sdk/src/constants.js
LICENSE_PRIVATE_KEY=


LLM_KEY_ENCRYPTION_SECRET=
# Free tier
# Global override — every connected wallet runs every agent, no purchase, no quota.
# Leave false outside local dev; it bypasses owner, purchase, and on-chain checks.
FREE_AGENT_ACCESS=false
# Successful runs a wallet gets on each agent before it has to buy. 0 disables trials.
FREE_RUNS_PER_AGENT=25
