# Copy to .env and fill in. Vite reads these at startup, so restart the dev server
# after any change. Every VITE_ variable is inlined into the browser bundle — none of
# them are secrets, so never put a private key or API secret here.

# Backend API. Falls back to http://localhost:5001/api when unset.
VITE_API_URL=http://localhost:5001/api

# WalletConnect / Reown project id, from https://cloud.reown.com.
# Without it the Connect Wallet modal opens EMPTY: Web3Modal fetches its wallet list
# from the relay and that call needs this id. There is no fallback for it in code.
VITE_WALLETCONNECT_PROJECT_ID=
